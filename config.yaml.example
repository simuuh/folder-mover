# Folder Mover - Configuration
# Copy this file to config.yaml and adjust to your setup.

# ── Paths ──────────────────────────────────────────────────────────────────────
download_dir: /home/user/Downloads
movies_dir: /mnt/Filme
series_dir: /mnt/Serien

# ── Web Server ─────────────────────────────────────────────────────────────────
host: 0.0.0.0
port: 8080

# Secret for session cookies. If empty, one is generated once and stored in
# `.secret_key` next to history.jsonl (sessions then survive restarts).
secret_key: ""

# Every setting can also be set via environment variables (FOLDER_MOVER_*),
# which take precedence over this file — see README.

# ── Authentication ─────────────────────────────────────────────────────────────
auth:
  username: admin
  # Preferred: a hash generated with  python app.py --hash-password
  password_hash: ""
  # Fallback: plaintext password (only used when password_hash is empty)
  password: changeme          # change this!

# ── Video file extensions to recognize ────────────────────────────────────────
video_extensions:
  - .mkv
  - .mp4
  - .avi
  - .m4v
  - .ts
  - .m2ts

# ── Extra wrapper folders ─────────────────────────────────────────────────────
# Python regexes for folder names that are never a release but only a container
# (UUID folders are always recognised). Matching folders are looked through,
# including wrappers inside wrappers.
wrapper_patterns: []
#  - '^jd-package-\d+$'
