# Folder Mover - Configuration
# Copy this file to config.yaml and adjust to your setup.

# ── Paths ──────────────────────────────────────────────────────────────────────
download_dir: /home/user/Downloads
movies_dir: /mnt/Filme
series_dir: /mnt/Serien

# Safety net for NAS mounts: only move if this file/folder exists in movies_dir
# AND series_dir (create it once: touch /mnt/Filme/.folder-mover /mnt/Serien/.folder-mover).
# Without it, an unmounted share is just an empty local folder and moves would
# silently fill the local disk. Empty = off.
mount_marker: ""

# ── Web Server ─────────────────────────────────────────────────────────────────
host: 0.0.0.0
port: 8080

# UI language: auto (browser language), de or en. The switch in the header
# overrides this per browser.
language: auto

# Secret for session cookies. If empty, one is generated once and stored in
# `.secret_key` next to history.jsonl (sessions then survive restarts).
secret_key: ""

# Every setting can also be set via environment variables (FOLDER_MOVER_*),
# which take precedence over this file — see README.

# ── Authentication ─────────────────────────────────────────────────────────────
auth:
  username: admin
  # Preferred: a hash generated with  python app.py --hash-password
  password_hash: ""
  # Fallback: plaintext password (only used when password_hash is empty).
  # Login stays disabled until one of the two is set ("changeme" is refused).
  password: ""

# ── Video file extensions to recognize ────────────────────────────────────────
video_extensions:
  - .mkv
  - .mp4
  - .avi
  - .m4v
  - .ts
  - .m2ts

# ── Junk that is never copied to the NAS ──────────────────────────────────────
# Glob patterns (* ? [abc], case-insensitive) matched against every file and
# folder name inside a movie release. Matches are not copied and are deleted
# together with the download. Setting this list REPLACES the defaults below —
# copy them and extend. [] copies everything.
junk_patterns:
  - '*.url'                 # "Rapidgator Premium Account" etc.
  - '*.lnk'
  - '*.website'
  - '*.webloc'
  - '*.desktop'
  - 'rushchk.log'
  - '*- COMPLETE )*'        # "[---] - ( 4932M 52F - COMPLETE ) - [---]"
  - 'thumbs.db'
  - 'desktop.ini'
  - '.ds_store'

# ── Extra wrapper folders ─────────────────────────────────────────────────────
# Python regexes for folder names that are never a release but only a container
# (UUID folders are always recognised). Matching folders are looked through,
# including wrappers inside wrappers.
wrapper_patterns: []
#  - '^jd-package-\d+$'
