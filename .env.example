# Folder Mover — Docker settings
# Copy to .env (next to docker-compose.yml) and adjust. .env is git-ignored.

# ── Container ──────────────────────────────────────────────────────────────────
FM_VERSION=latest           # image tag, e.g. 1.3.0 to pin a version
FM_PORT=8080                # port on the host
TZ=Europe/Zurich
FOLDER_MOVER_LANGUAGE=auto  # auto (browser language), de or en

# uid/gid that owns your downloads and media folders (`id <user>` on the host;
# often 1026/100 on Synology, 99/100 on Unraid)
PUID=1000
PGID=1000

# ── Host paths ─────────────────────────────────────────────────────────────────
FM_CONFIG_PATH=./config                 # history, session secret, optional config.yaml
FM_DOWNLOADS_PATH=/path/to/downloads
FM_MOVIES_PATH=/path/to/media/Filme
FM_SERIES_PATH=/path/to/media/Serien

# Only move if this file exists in the movies AND series folder (create it once
# on the NAS, e.g. `touch .folder-mover` in both). Protects against writing into
# an empty mountpoint when the share is not mounted. Empty = off.
FOLDER_MOVER_MOUNT_MARKER=

# Seconds without an answer from a folder before "NAS not responding" is
# reported (scan/move refused, a running move flagged). 0 = off. Default 30.
FOLDER_MOVER_NAS_TIMEOUT=

# Warn in the UI below this many GB free on the movies/series share (0 = off).
FOLDER_MOVER_SPACE_WARNING_GB=

# Moves kept in the history (default 10000, 0 = unlimited).
FOLDER_MOVER_HISTORY_MAX=

# ── Media servers (optional) ───────────────────────────────────────────────────
# Rescan the library after a move. URL as seen from this container (same
# Docker network: http://jellyfin:8096). Test: docker compose exec folder-mover
# python app.py --refresh-library
FOLDER_MOVER_JELLYFIN_URL=
FOLDER_MOVER_JELLYFIN_API_KEY=
FOLDER_MOVER_PLEX_URL=
FOLDER_MOVER_PLEX_TOKEN=

# ── Login ──────────────────────────────────────────────────────────────────────
FOLDER_MOVER_USERNAME=admin

# Preferred: a password hash, created with
#   docker run --rm -it ghcr.io/simuuh/folder-mover python app.py --hash-password
# Keep the SINGLE quotes — the hash contains $ characters.
FOLDER_MOVER_PASSWORD_HASH=''

# Fallback plaintext password, only used while no hash is set.
# Login stays disabled until one of the two is set ("changeme" is refused).
FOLDER_MOVER_PASSWORD=
