# Folder Mover — Docker settings
# Copy to .env (next to docker-compose.yml) and adjust. .env is git-ignored.

# ── Container ──────────────────────────────────────────────────────────────────
FM_VERSION=latest           # image tag, e.g. 1.3.0 to pin a version
FM_PORT=8080                # port on the host
TZ=Europe/Zurich

# uid/gid that owns your downloads and media folders (`id <user>` on the host;
# often 1026/100 on Synology, 99/100 on Unraid)
PUID=1000
PGID=1000

# ── Host paths ─────────────────────────────────────────────────────────────────
FM_CONFIG_PATH=./config                 # history, session secret, optional config.yaml
FM_DOWNLOADS_PATH=/path/to/downloads
FM_MOVIES_PATH=/path/to/media/Filme
FM_SERIES_PATH=/path/to/media/Serien

# ── Login ──────────────────────────────────────────────────────────────────────
FOLDER_MOVER_USERNAME=admin

# Preferred: a password hash, created with
#   docker run --rm -it ghcr.io/simuuh/folder-mover python app.py --hash-password
# Keep the SINGLE quotes — the hash contains $ characters.
FOLDER_MOVER_PASSWORD_HASH=''

# Fallback plaintext password, only used while no hash is set
FOLDER_MOVER_PASSWORD=changeme
